<Application
	x:Class="LRReader.UWP.Installer.App"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="using:Microsoft.UI.Xaml.Controls"
	xmlns:converters="using:LRReader.UWP.Installer.Converters">
	<Application.Resources>
		<controls:XamlControlsResources>
			<controls:XamlControlsResources.MergedDictionaries>
				<ResourceDictionary>
					<converters:InstallStateToVisibilityConverter x:Key="InstallStateToVisibilityConverter" />
					<converters:ProgressBarIsIndeterminateConverter x:Key="ProgressBarIsIndeterminateConverter" />
				</ResourceDictionary>
			</controls:XamlControlsResources.MergedDictionaries>
		</controls:XamlControlsResources>
	</Application.Resources>
</Application>
