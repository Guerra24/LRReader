<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0-browser;net11.0;net11.0-windows10.0.26100.0</TargetFrameworks>
    <UseWindowsSDKPreview>true</UseWindowsSDKPreview>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!--<RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>-->
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <WindowsSdkPackageVersion>10.0.26100.87</WindowsSdkPackageVersion>
    <CsWinRTAotWarningLevel>3</CsWinRTAotWarningLevel>
    <CsWinRTEnableManifestFreeActivation>false</CsWinRTEnableManifestFreeActivation>
    <DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Features Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net11.0'))">runtime-async=on</Features>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net11.0-windows10.0.26100.0'">
    <DefineConstants>$(DefineConstants);WINDOWS_UWP</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AvifNet" Version="0.0.0-alpha.0.6" />
    <PackageReference Include="CommunityToolkit.Common" Version="8.4.2" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Caching" Version="5.1.3" />
    <PackageReference Include="JxlNet" Version="0.12.0.2" />
    <PackageReference Include="KeyedSemaphores" Version="6.1.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0-rc.2.26504.105" />
    <PackageReference Include="RestSharp" Version="114.0.0" />
    <PackageReference Include="Sentry" Version="6.12.0" />
    <PackageReference Include="SixLabors.ImageSharp" Version="4.1.3" />
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.3.1" Condition="'$(TargetFramework)' == 'net11.0-windows10.0.26100.0'" />
  </ItemGroup>

</Project>
